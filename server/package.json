{
  "name": "dms-pro-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:push": "prisma db push",
    "db:push:pg": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "db:generate:pg": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:setup:pg": "prisma db push --schema=prisma/schema.postgresql.prisma && node prisma/seed.js",
    "db:seed": "node prisma/seed.js",
    "db:setup": "prisma db push && node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1"
  }
}
