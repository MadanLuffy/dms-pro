generator client {
  provider = "prisma-client-js"
}

// SQLite is used for local development.
// For production, switch datasource provider to "postgresql" and update DATABASE_URL.
// NOTE: replace @db.Text and string-based enum fields with native Postgres enums:
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  name         String
  passwordHash String
  // STAFF | DEPT_HEAD | CEO | SUPERADMIN
  role         String          @default("STAFF")
  deptId       String
  department   Department      @relation(fields: [deptId], references: [id])
  files        SubjectFile[]   @relation("FileCreator")
  assigned     SubjectFile[]   @relation("AssignedOfficer")
  notes        Note[]
  approvals    ApprovalMatrix[]
  auditLogs    AuditLog[]
  createdAt    DateTime        @default(now())

  @@index([deptId])
  @@index([role])
}

model Department {
  id       String            @id
  name     String
  users    User[]
  targets  SubjectFileDept[]
  approval ApprovalMatrix[]
}

model SubjectFile {
  id                 String            @id @default(uuid())
  refNo              String            @unique
  subject            String
  // LOW | NORMAL | HIGH | URGENT
  priority           String            @default("NORMAL")
  // OPEN | INTERNAL | CONFIDENTIAL | SECRET
  secrecy            String            @default("INTERNAL")
  // DRAFT | DEPT_HEAD_REVIEW | CEO_REVIEW | APPROVED | RETURNED
  status             String            @default("DEPT_HEAD_REVIEW")
  creatorId          String
  creator            User              @relation("FileCreator", fields: [creatorId], references: [id])
  assignedOfficerId  String?
  assignedOfficer    User?             @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  notes              Note[]
  attachments        Attachment[]
  targetDepts        SubjectFileDept[]
  approvalMatrix     ApprovalMatrix[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([creatorId])
  @@index([assignedOfficerId])
  @@index([status])
  @@index([updatedAt])
}

model SubjectFileDept {
  id        String      @id @default(uuid())
  fileId    String
  file      SubjectFile @relation(fields: [fileId], references: [id])
  deptId    String
  department Department @relation(fields: [deptId], references: [id])

  @@unique([fileId, deptId])
  @@index([fileId])
  @@index([deptId])
}

model Note {
  id          String       @id @default(uuid())
  version     Int
  fileId      String
  file        SubjectFile  @relation(fields: [fileId], references: [id])
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  parentId    String?
  parent      Note?        @relation("NoteReplies", fields: [parentId], references: [id])
  replies     Note[]       @relation("NoteReplies")
  sentTo      String
  content     String
  order       Int
  attachments Attachment[]
  createdAt   DateTime     @default(now())

  @@index([fileId])
  @@index([parentId])
  @@index([authorId])
}

model Attachment {
  id         String      @id @default(uuid())
  fileId     String
  file       SubjectFile @relation(fields: [fileId], references: [id])
  noteId     String?
  note       Note?       @relation(fields: [noteId], references: [id])
  filename   String
  fileUrl    String
  mimeType   String
  sizeBytes  Int
  uploadedAt DateTime    @default(now())

  @@index([fileId])
  @@index([noteId])
}

model ApprovalMatrix {
  id        String      @id @default(uuid())
  fileId    String
  file      SubjectFile @relation(fields: [fileId], references: [id])
  deptId    String
  department Department @relation(fields: [deptId], references: [id])
  // PENDING | APPROVED | RETURNED
  status    String      @default("PENDING")
  reviewedBy String?
  reviewer  User?       @relation(fields: [reviewedBy], references: [id])
  comments  String?
  // DEPT | CEO
  gate      String      @default("DEPT")
  timestamp DateTime?

  @@index([fileId])
  @@index([fileId, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}