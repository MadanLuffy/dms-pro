# Local SQLite (default)
DATABASE_URL="file:./dev.db"
PORT=5120
JWT_SECRET="change-me-in-production"
CLIENT_ORIGIN="http://localhost:5188"

# Production (Railway / Render / Docker)
# NODE_ENV=production
# PORT=5120
# JWT_SECRET="long-random-secret"
# CLIENT_ORIGIN="https://your-domain.com"
# DATABASE_URL="postgresql://user:pass@host:5432/dms"
# TRUST_PROXY=1
# COOKIE_SAMESITE=lax
# ALLOW_DEMO_SEED=false
# BOOTSTRAP_ADMIN_EMAIL="admin@your-org.com"
# BOOTSTRAP_ADMIN_PASSWORD="set-a-strong-password"
# BOOTSTRAP_ADMIN_NAME="Administrator"
#
# Split frontend (Vercel) + API: set COOKIE_SAMESITE=none and CLIENT_ORIGIN to the Vercel origin.
# RATE_LIMIT_STORE=redis is documented for multi-instance; in-memory is used by default.
