# ── Production ─────────────────────────────────────────────────────────
# Copy this to your host's real environment (NOT as a file committed with
# the app). Generate secrets per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NODE_ENV=production
PORT=5120

# Postgres (immutable/fleeting SQLite is not suitable for production):
#   npx prisma db push --schema=server/prisma/schema.postgresql.prisma
DATABASE_URL="postgresql://dms:REPLACE_STRONG_PASSWORD@127.0.0.1:5432/dms"

# REQUIRED. Long random value unique to this instance.
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# REQUIRED. Public origin(s) of the deployed frontend. Comma-separate for multiple.
CLIENT_ORIGIN="https://your-domain.com"

# Set 1 when behind TLS-terminating proxy (Railway/Render/nginx).
# TRUST_PROXY=1

# 'lax' (same-origin cookie) or 'none' (split frontend + API on different hosts, requires HTTPS).
# COOKIE_SAMESITE=lax

# Security: demo users with a shared known password are NEVER created here.
ALLOW_DEMO_SEED=false

# First SUPERADMIN account, created only if it does not already exist.
# BOOTSTRAP_ADMIN_EMAIL="admin@your-org.com"
# BOOTSTRAP_ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
# BOOTSTRAP_ADMIN_NAME="Administrator"