{
  "name": "docmanagement-dms-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "npm run dev --prefix server",
    "dev:all": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm run server\" \"npm run dev\"",
    "start": "npm start --prefix server",
    "db:push": "npm run db:push --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "db:push:pg": "npm run db:push:pg --prefix server",
    "db:generate:pg": "npm run db:generate:pg --prefix server",
    "prod": "npm run build && npm start --prefix server",
    "deploy:check": "node scripts/deploy-check.mjs",
    "test:e2e": "node e2e.test.mjs && node e2e.flow.test.mjs && node e2e.admin.test.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "mammoth": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "puppeteer-core": "^25.10.0",
    "vite": "^5.4.9"
  }
}
